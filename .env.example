# Copy to .env and fill in. Never commit .env.

# --- LLM (the only paid dependency) ---
# Provider key(s) used through LiteLLM, e.g. ANTHROPIC_API_KEY or OPENAI_API_KEY
LLM_API_KEY=
LLM_MODEL_CHEAP=
LLM_MODEL_STRONG=

# --- Budgets ---
REPORT_BUDGET_USD_STANDARD=0.50
REPORT_TIME_BUDGET_SECONDS=300

# --- Infrastructure (docker compose defaults) ---
# 5433, not 5432: avoids clashing with a system-installed Postgres on the host.
DATABASE_URL=postgresql+asyncpg://fieldbrief:fieldbrief@localhost:5433/fieldbrief
# 5673, not 5672: avoids clashing with a system-installed RabbitMQ on the host.
RABBITMQ_URL=amqp://fieldbrief:fieldbrief@localhost:5673/
SEARXNG_URL=http://localhost:8080

# --- Sources ---
# SEC requires a descriptive User-Agent with contact info
SEC_USER_AGENT="Fieldbrief/0.1 your-email@example.com"

# --- Tracing (self-hosted Langfuse) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- API ---
API_KEY=change-me
