# Copy to .env and fill in. Never commit .env.

# --- LLM (the only paid dependency) ---
# Provider key(s) used through LiteLLM, e.g. ANTHROPIC_API_KEY or OPENAI_API_KEY
LLM_API_KEY=
LLM_MODEL_CHEAP=
LLM_MODEL_STRONG=

# --- Budgets ---
REPORT_BUDGET_USD_STANDARD=0.50
REPORT_TIME_BUDGET_SECONDS=300

# --- Infrastructure (docker compose defaults) ---
DATABASE_URL=postgresql+asyncpg://fieldbrief:fieldbrief@localhost:5432/fieldbrief
RABBITMQ_URL=amqp://fieldbrief:fieldbrief@localhost:5672/
SEARXNG_URL=http://localhost:8080

# --- Sources ---
# SEC requires a descriptive User-Agent with contact info
SEC_USER_AGENT="Fieldbrief/0.1 your-email@example.com"

# --- Tracing (self-hosted Langfuse) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- API ---
API_KEY=change-me
