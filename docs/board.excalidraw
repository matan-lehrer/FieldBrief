   "isDeleted": false,
   "boundElements": [],
   "updated": 1792584397639,
   "link": null,
   "locked": false,
   "text": "- Accuracy - >= 90% of claims supported by cited sources\n- Cost - <= $0.50 per standard report\n- Latency - <= 200 ms acknowledgment, live progress every <= 2s,\n                 first results <= 60s, full report <= 5 min (p95)\n- Reliability - >= 99% jobs complete (>= 95% fully)\n- Scalability - horizontally scalable, modular components\n- Observability - 100% of runs traced with cost/latency breakdown",
   "originalText": "- Accuracy - >= 90% of claims supported by cited sources\n- Cost - <= $0.50 per standard report\n- Latency - <= 200 ms acknowledgment, live progress every <= 2s,\n                 first results <= 60s, full report <= 5 min (p95)\n- Reliability - >= 99% jobs complete (>= 95% fully)\n- Scalability - horizontally scalable, modular components\n- Observability - 100% of runs traced with cost/latency breakdown",
   "fontSize": 20,
   "fontFamily": 5,
