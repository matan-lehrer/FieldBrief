   "link": null,
   "locked": false,
   "text": "- Peak: ~100 reports/s, ~15K concurrent jobs\n- LLM: ~17M tokens/s at peak -> the real bottleneck\n- Search: ~2K queries/s at peak\n- Cost: ~$0.34/report, ~$30M/month before cache\n- Unit economics: ~$30/user/month -> price above it, cache cuts it\n- Storage: ~4.5TB/month of reports, ~40GB hot cache\n- MVP reality: 1 user, 1 worker, <= $0.50/report",
   "originalText": "- Peak: ~100 reports/s, ~15K concurrent jobs\n- LLM: ~17M tokens/s at peak -> the real bottleneck\n- Search: ~2K queries/s at peak\n- Cost: ~$0.34/report, ~$30M/month before cache\n- Unit economics: ~$30/user/month -> price above it, cache cuts it\n- Storage: ~4.5TB/month of reports, ~40GB hot cache\n- MVP reality: 1 user, 1 worker, <= $0.50/report",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  }
