  {
   "id": "t11",
   "type": "text",
   "x": 1010,
   "y": 55,
   "width": 858.0000000000001,
   "height": 850.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
